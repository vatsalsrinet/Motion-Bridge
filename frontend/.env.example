# Point the dev proxy at a backend other than http://localhost:3000
VITE_API_TARGET=http://localhost:3000

# Force mock agent responses even when a backend is reachable.
# You can also do this at runtime with ?mock=1 in the URL.
VITE_USE_MOCKS=false

# Python gesture WebSocket. Keep false to use the real tracker.
VITE_VISION_WS_URL=ws://127.0.0.1:8000/ws/vision
